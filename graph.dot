digraph G {
	bgcolor = "transparent";
	rankdir = LR;
	node [shape = Mrecord, color = darkred, style = filled, fillcolor = pink];
	edge [color = "white", penwidth = 2];

	node0 [label = "{[0]} | {index | 0} | {next | 2} | {prev | 3}", fillcolor = darkgrey];
	node2 [label = "{20} | {index | 2} | {next | 3} | {prev | 0}"];
	node3 [label = "{30} | {index | 3} | {next | 0} | {prev | 2}"];

	node0-> node2;
	node2-> node3;
	node3:s -> node0:s;
}