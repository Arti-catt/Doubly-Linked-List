digraph G {
	rankdir = LR;
	node [shape = Mrecord, color = red, style = filled, fillcolor = pink];
	edge [color = darkred];

	node0 [label = "{-666} | {index | 0} | {next | 1} | {prev | 3}", fillcolor = pink];
	node1 [label = "{10} | {index | 1} | {next | 2} | {prev | 0}", fillcolor = pink];
	node2 [label = "{20} | {index | 2} | {next | 3} | {prev | 1}", fillcolor = pink];
	node3 [label = "{30} | {index | 3} | {next | 0} | {prev | 2}", fillcolor = pink];

	node0-> node1;
	node1-> node2;
	node2-> node3;
	node3:s -> node0:s;
}